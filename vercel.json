{
  "rewrites": [
    { "source": "/beheer", "destination": "/index.html" },
    { "source": "/beheer/", "destination": "/index.html" },
    { "source": "/api/content", "destination": "/api/site?resource=content" },
    {
      "source": "/api/admin-teksten",
      "destination": "/api/site?resource=teksten"
    },
    {
      "source": "/api/admin-filters",
      "destination": "/api/site?resource=filters"
    },
    {
      "source": "/api/analytics",
      "destination": "/api/site?resource=analytics"
    },
    {
      "source": "/api/admin-password",
      "destination": "/api/admin-login?action=password"
    }
  ]
}
