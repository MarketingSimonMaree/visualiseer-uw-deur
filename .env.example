# Kopieer dit bestand naar .env.local en vul je eigen sleutels in:
#   cp .env.example .env.local
OPENAI_API_KEY=
DATABASE_URL=

# Optioneel bootstrap: als user carlton nog niet bestaat, wordt die aangemaakt
# met dit wachtwoord (default admin1234).
ADMIN_PASSWORD=admin1234

# Optioneel: aparte signing-secret voor admin-tokens
# ADMIN_SECRET=

# Optioneel: e-mail via Mailjet (visualisatie + leads)
# MAILJET_API_KEY=       # public key
# MAILJET_API_SECRET=    # private key
# MAIL_FROM=Simon Maree <visualisatie@simonmaree.nl>
# LEADS_EMAIL=info@simonmaree.nl
