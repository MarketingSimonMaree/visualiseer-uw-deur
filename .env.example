# Kopieer dit bestand naar .env.local en vul je eigen sleutels in:
#   cp .env.example .env.local
OPENAI_API_KEY=
DATABASE_URL=

# Bootstrap-wachtwoord voor /beheer (default: admin1234).
# Zodra je het wachtwoord in beheer wijzigt, geldt die uit de database.
ADMIN_PASSWORD=admin1234

# Optioneel: aparte signing-secret voor admin-tokens
# ADMIN_SECRET=
